# Copy to a local .env (never commit it) or set these in your shell.
# Names and safe defaults only. Do not put real secret values in this file.

APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL for docker compose (docker-compose.yml). Choose your own password.
POSTGRES_DB=travelmate
POSTGRES_USER=travelmate
POSTGRES_PASSWORD=<set-a-local-password>

# Where each data category comes from. Only "mock" can start: there is no live
# provider yet and live providers need the owner's authorisation.
PROVIDER_MODE_TRANSPORT=mock
PROVIDER_MODE_HOTEL=mock
PROVIDER_MODE_WEATHER=mock

# Language model. Optional: the demo and the tests need neither. Set the real key only in
# your own shell, never in a file that is committed. A blank value means "not set".
OPENAI_API_KEY=
LLM_MODEL=

# Real model calls for the chat's plans (POST /api/v1/chat/plans). OFF by default: with this
# false, or unset, nothing ever reaches OpenAI, even if OPENAI_API_KEY is set, and the plan is a
# labelled scripted sample. Switching it on needs CONVERSATION_ENABLED=true, the key, LLM_MODEL and
# every value below. Calls cost money; the hourly cap counts every call, retries included.
# Set the real key only in your own shell. Never commit it.
LLM_LIVE_ENABLED=false
LLM_MAX_CALLS_PER_HOUR=
CONVERSATION_PLAN_MAX_OUTPUT_TOKENS=
CONVERSATION_PLAN_TIMEOUT_SECONDS=

# Voice sessions. Off by default. There is no voice provider yet, so a session carries no audio.
# When VOICE_ENABLED is true every value below must be set, VOICE_DEV_PRINCIPAL names the one
# local developer the API acts for, and the app refuses to start in production.
VOICE_ENABLED=false
VOICE_DEV_PRINCIPAL=
VOICE_SESSION_MAX_SECONDS=
VOICE_SESSION_IDLE_SECONDS=
VOICE_MAX_ACTIVE_SESSIONS_PER_OWNER=
VOICE_MAX_SESSIONS_PER_DAY_PER_OWNER=

# Typed trip chat (POST /api/v1/chat/turns). Off by default. It runs on a development stand-in
# for the language model (simple patterns, not a model), so the app refuses to start with it on
# in production. When CONVERSATION_ENABLED is true every value below must be set.
CONVERSATION_ENABLED=false
CONVERSATION_MAX_MESSAGE_CHARS=
CONVERSATION_LLM_MAX_OUTPUT_TOKENS=
CONVERSATION_LLM_TIMEOUT_SECONDS=

# Must stay false. Booking execution is not implemented (see docs/ARCHITECTURE.md §6).
BOOKING_ENABLED=false
